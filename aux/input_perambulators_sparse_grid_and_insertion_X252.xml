<QudaLaph>
  <EchoXML/>
  <LatticeLayoutInfo>
     <XYZTExtents>36 36 36 128</XYZTExtents>
  </LatticeLayoutInfo>
  <QudaInfo>
     <CPUPrecision>double</CPUPrecision>
     <CUDAPrecision>double</CUDAPrecision>
     <CUDASloppyPrecision>single</CUDASloppyPrecision>
  </QudaInfo>
  <Verbosity>none</Verbosity>

  <Task>
     <Name>SMEAR_GAUGE_FIELD</Name>
     <GaugeConfigurationInfo>
        <EnsembleName>CLS_X252</EnsembleName>
        <FileFormat>CERN</FileFormat>
        <ConfigType>WilsonImproved</ConfigType>
        <FileName>/lustre/romerfl8/X252r000/X252r000n__CFGNUM__</FileName>
        <ConfigNumber>__CFGNUM__</ConfigNumber>
     </GaugeConfigurationInfo>
     <GluonStoutSmearingInfo>
        <LinkIterations>36</LinkIterations>
        <LinkStapleWeight>0.1</LinkStapleWeight>
     </GluonStoutSmearingInfo>
     <SmearedGaugeFileName>NOM_smeared_gauge_field</SmearedGaugeFileName>
  </Task> 

  <Task>
     <Name>SMEAR_QUARK_FIELD</Name>
     <GaugeConfigurationInfo>
        <EnsembleName>CLS_X252</EnsembleName>
        <FileFormat>CERN</FileFormat>
        <ConfigType>WilsonImproved</ConfigType>
        <FileName>/lustre/romerfl8/X252r000/X252r000n__CFGNUM__</FileName>
        <ConfigNumber>__CFGNUM__</ConfigNumber>
     </GaugeConfigurationInfo>
     <GluonStoutSmearingInfo>
        <LinkIterations>36</LinkIterations>
        <LinkStapleWeight>0.1</LinkStapleWeight>
     </GluonStoutSmearingInfo>
     <SmearedGaugeFileName>NOM_smeared_gauge_field</SmearedGaugeFileName>
     <QuarkLaphSmearingInfo>
        <LaphSigmaCutoff>0.077</LaphSigmaCutoff>
        <NumberLaphEigvecs>48</NumberLaphEigvecs>
     </QuarkLaphSmearingInfo>
     <SmearedQuarkFileStub>NOM_smeared_quark_field</SmearedQuarkFileStub>
     <LaphEigenSolverInfo>
        <ResidualTolerance>1.0e-11</ResidualTolerance>
        <MaxIterations>48</MaxIterations>
        <KrylovDimension>64</KrylovDimension>
        <ChebyshevOrder>32</ChebyshevOrder>
	<MaxEigenvalue>12.01</MaxEigenvalue>
        <StartingVectorType>random</StartingVectorType>
        <CutoffEigenvalue>0.09</CutoffEigenvalue>
        <OutputVerbosity>2</OutputVerbosity>
       </LaphEigenSolverInfo>
  </Task> 

  <Task>
     <Name>LAPH_QUARK_PERAMBULATORS</Name>
     <QuarkPerambulatorInfo>
        <GaugeConfigurationInfo>
           <EnsembleName>CLS_X252</EnsembleName>
           <FileFormat>CERN</FileFormat>
           <ConfigType>WilsonImproved</ConfigType>
           <FileName>/lustre/romerfl8/X252r000/X252r000n__CFGNUM__</FileName>
           <ConfigNumber>__CFGNUM__</ConfigNumber>
           <FermionTimeBC>antiperiodic</FermionTimeBC>
        </GaugeConfigurationInfo>
        <GluonStoutSmearingInfo>
           <LinkIterations>36</LinkIterations>
           <LinkStapleWeight>0.1</LinkStapleWeight>
        </GluonStoutSmearingInfo>
        <SmearedGaugeFileName>NOM_smeared_gauge_field</SmearedGaugeFileName>
        <QuarkLaphSmearingInfo>
           <LaphSigmaCutoff>0.077</LaphSigmaCutoff>
           <NumberLaphEigvecs>48</NumberLaphEigvecs>
        </QuarkLaphSmearingInfo>
        <SmearedQuarkFileStub>NOM_smeared_quark_field</SmearedQuarkFileStub>
        <QuarkActionInfo>
           <Name> WILSON_CLOVER </Name>
           <Flavor> ud </Flavor>
           <Kappa>0.137140</Kappa>
           <clovCoeff>1.8248654</clovCoeff>
           <TimeBC> antiperiodic </TimeBC>
         </QuarkActionInfo>
        <FileListInfo>
	   <FileNameStub>/lustre/schredgf/cls21/X252r000/data_quda/__CFGNUM__/perambs_cnfg___CFGNUM__</FileNameStub>
           <MinFileNumber>0</MinFileNumber>
           <MaxFileNumber>1500</MaxFileNumber>
        </FileListInfo>
	<RandomSparseGridInfo>
          <RandomSeed>__SEED__</RandomSeed>
          <GridSpacing>4</GridSpacing>
          <FileListInfo>
            <FileNameStub>/lustre/schredgf/cls21/X252r000/data_quda/__CFGNUM__/perambs_sparse_cnfg___CFGNUM__</FileNameStub>
            <MinFileNumber>0</MinFileNumber>
            <MaxFileNumber>1500</MaxFileNumber>
          </FileListInfo>
          <FileListInfo>
            <FileNameStub>/lustre/schredgf/cls21/X252r000/data_quda/__CFGNUM__/perambs_sparseIns_cnfg___CFGNUM__</FileNameStub>
            <MinFileNumber>0</MinFileNumber>
            <MaxFileNumber>1500</MaxFileNumber>
          </FileListInfo>
        </RandomSparseGridInfo>
	 <InsertionInfo>
          <Name>WilsonCloverTwist</Name>
          <twist_vector>1 1 1 0</twist_vector>
          <FileListInfo>
            <FileNameStub>/lustre/schredgf/cls21/X252r000/data_quda/__CFGNUM__/perambs_Ins_cnfg___CFGNUM__</FileNameStub>
            <MinFileNumber>0</MinFileNumber>
            <MaxFileNumber>1500</MaxFileNumber>
          </FileListInfo>
        </InsertionInfo> 
        <InverterInfo>                                                              
           <Name>GCR_MULTIGRID</Name>                                              
           <Tolerance>1.0e-12</Tolerance>
           <MaxIterations>200</MaxIterations>                                      
           <NKrylov>24</NKrylov>                                                   
           <MGPreconditioner>                                                      
              <NumLevels>2</NumLevels>              
              <Level0>                                                             
                 <XYZTBlockExtents>6 6 6 4</XYZTBlockExtents>          
                 <NullSpaceDim>S</NullSpaceDim>          
                 <NullSpaceSolveSteps>300</NullSpaceSolveSteps>                    
                 <CoarseSolverTolerance>0.25</CoarseSolverTolerance>               
                 <CoarseSolverMaxIterations>50</CoarseSolverMaxIterations>         
                 <NumPreSmooth>0</NumPreSmooth>                                    
                 <NumPostSmooth>4</NumPostSmooth>                                  
              </Level0>                                                            
              <Level1>                                       
                 <CoarseSolverTolerance>0.25</CoarseSolverTolerance>               
                 <CoarseSolverMaxIterations>50</CoarseSolverMaxIterations>         
                 <TRLMDeflation>
                    <NumVectors> 128 </NumVectors>                                         
                    <Tolerance> 1e-6 </Tolerance>                                          
                    <MaxIterations> 200 </MaxIterations>                                   
                    <ChebyshevOrder> 16 </ChebyshevOrder>                                   
                    <CutoffEigenvalue> 0.1 </CutoffEigenvalue>                             
                 </TRLMDeflation>             
              </Level1>                                                            
              <LoadNullVectors>false</LoadNullVectors>       
              <GenerateAllLevels>true</GenerateAllLevels>     
              <PreOrthoNullVectors>true</PreOrthoNullVectors>                      
              <PostOrthoNullVectors>true</PostOrthoNullVectors>                    
	      <SetupMinimizeMemory>false</SetupMinimizeMemory>                      
              <RunVerify>false</RunVerify>           
           </MGPreconditioner>                                                     
        </InverterInfo>                                                             
	<Verbosity>none</Verbosity>
       <ExtraSolutionChecks/>
     </QuarkPerambulatorInfo>
     <ComputationSet>
        <NumSinksBeforeProject>  1 </NumSinksBeforeProject>
        <NumSinksInProjectBatch> 1 </NumSinksInProjectBatch>
        <NumEigsInProjectBatch>  1 </NumEigsInProjectBatch>
	<Computation>
          <SourceTime>__SRC_TIME0__</SourceTime>
          <SourceLaphEigvecIndexMin>0</SourceLaphEigvecIndexMin>
          <SourceLaphEigvecIndexMax>47</SourceLaphEigvecIndexMax>
        </Computation>
        <Computation>
          <SourceTime>__SRC_TIME1__</SourceTime>
          <SourceLaphEigvecIndexMin>0</SourceLaphEigvecIndexMin>
          <SourceLaphEigvecIndexMax>47</SourceLaphEigvecIndexMax>
        </Computation>
        <Computation>
          <SourceTime>__SRC_TIME2__</SourceTime>
          <SourceLaphEigvecIndexMin>0</SourceLaphEigvecIndexMin>
          <SourceLaphEigvecIndexMax>47</SourceLaphEigvecIndexMax>
        </Computation>
        <Computation>
          <SourceTime>__SRC_TIME3__</SourceTime>
          <SourceLaphEigvecIndexMin>0</SourceLaphEigvecIndexMin>
          <SourceLaphEigvecIndexMax>47</SourceLaphEigvecIndexMax>
  	</Computation>
	<Computation>
          <SourceTime>__SRC_TIME4__</SourceTime>
          <SourceLaphEigvecIndexMin>0</SourceLaphEigvecIndexMin>
          <SourceLaphEigvecIndexMax>47</SourceLaphEigvecIndexMax>
        </Computation>
        <Computation>
          <SourceTime>__SRC_TIME5__</SourceTime>
          <SourceLaphEigvecIndexMin>0</SourceLaphEigvecIndexMin>
          <SourceLaphEigvecIndexMax>47</SourceLaphEigvecIndexMax>
        </Computation>
        <Computation>
          <SourceTime>__SRC_TIME6__</SourceTime>
          <SourceLaphEigvecIndexMin>0</SourceLaphEigvecIndexMin>
          <SourceLaphEigvecIndexMax>47</SourceLaphEigvecIndexMax>
        </Computation>
        <Computation>
          <SourceTime>__SRC_TIME7__</SourceTime>
          <SourceLaphEigvecIndexMin>0</SourceLaphEigvecIndexMin>
          <SourceLaphEigvecIndexMax>47</SourceLaphEigvecIndexMax>
        </Computation>
     </ComputationSet>
 </Task>
</QudaLaph>
