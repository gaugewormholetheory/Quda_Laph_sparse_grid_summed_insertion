<QudaLaph>
  <EchoXML/>
  <LatticeLayoutInfo>
     <XYZTExtents>16 16 16 16</XYZTExtents>
  </LatticeLayoutInfo>
  <QudaInfo>
     <CPUPrecision>double</CPUPrecision>
     <CUDAPrecision>double</CUDAPrecision>
     <CUDASloppyPrecision>single</CUDASloppyPrecision>
  </QudaInfo>
  <Verbosity>none</Verbosity>

  <Task>
     <Name>LAPH_MERGE_PERAMBULATORS</Name>
     <QuarkPerambulatorInfo>
        <GaugeConfigurationInfo>
           <EnsembleName>YMtest5</EnsembleName>
           <FileFormat>CERN</FileFormat>
           <ConfigType>WilsonImproved</ConfigType>
           <FileName>/lustre/schredgf/test/YMt5r000n1</FileName>
           <ConfigNumber>1</ConfigNumber>
           <FermionTimeBC>antiperiodic</FermionTimeBC>
        </GaugeConfigurationInfo>
        <GluonStoutSmearingInfo>
           <LinkIterations>20</LinkIterations>
           <LinkStapleWeight>0.1</LinkStapleWeight>
        </GluonStoutSmearingInfo>
        <SmearedGaugeFileName>NOM_smeared_gauge_field</SmearedGaugeFileName>
        <QuarkLaphSmearingInfo>
           <LaphSigmaCutoff>0.32</LaphSigmaCutoff>
           <NumberLaphEigvecs>4</NumberLaphEigvecs>
        </QuarkLaphSmearingInfo>
        <SmearedQuarkFileStub>NOM_smeared_quark_field</SmearedQuarkFileStub>
        <QuarkActionInfo>
           <Name> WILSON_CLOVER </Name>
           <Flavor> s </Flavor>
           <Kappa>0.12</Kappa>
           <clovCoeff>1.23</clovCoeff>
           <TimeBC> antiperiodic </TimeBC>
         </QuarkActionInfo>
         <FileListInfo>
           <FileNameStub>quda_peramb_merged</FileNameStub>
           <MinFileNumber>0</MinFileNumber>
           <MaxFileNumber>30</MaxFileNumber>
        </FileListInfo>
        <RandomSparseGridInfo>
          <RandomSeed>10</RandomSeed>
          <GridSpacing>4</GridSpacing>
          <FileListInfo>
            <FileNameStub>quda_sparse_merged</FileNameStub>
            <MinFileNumber>0</MinFileNumber>
            <MaxFileNumber>30</MaxFileNumber>
          </FileListInfo>
          <InputFileListInfos>
                <FileListInfo>
                        <FileNameStub>quda_sparse</FileNameStub>
                        <MinFileNumber>0</MinFileNumber>
                        <MaxFileNumber>200</MaxFileNumber>
                </FileListInfo>
                <FileListInfo>
                        <FileNameStub>quda_sparse_2nd</FileNameStub>
                        <MinFileNumber>0</MinFileNumber>
                        <MaxFileNumber>200</MaxFileNumber>
                </FileListInfo>
          </InputFileListInfos>
          <FileListInfo>
            <FileNameStub>quda_spins_merged</FileNameStub>
            <MinFileNumber>0</MinFileNumber>
            <MaxFileNumber>30</MaxFileNumber>
          </FileListInfo>
	<InputFileListInfos>
                <FileListInfo>
                        <FileNameStub>quda_spins</FileNameStub>
                        <MinFileNumber>0</MinFileNumber>
                        <MaxFileNumber>200</MaxFileNumber>
                </FileListInfo>
                <FileListInfo>
                        <FileNameStub>quda_spins_2nd</FileNameStub>
                        <MinFileNumber>0</MinFileNumber>
                        <MaxFileNumber>200</MaxFileNumber>
                </FileListInfo>
          </InputFileListInfos>
        </RandomSparseGridInfo>
        <InsertionInfo>
          <Name>WilsonCloverTwist</Name>
          <twist_vector>1 1 1 0</twist_vector>
          <FileListInfo>
            <FileNameStub>quda_insert_merged</FileNameStub>
            <MinFileNumber>0</MinFileNumber>
            <MaxFileNumber>30</MaxFileNumber>
          </FileListInfo>
	  <InputFileListInfos>
                <FileListInfo>
                        <FileNameStub>quda_insert</FileNameStub>
                        <MinFileNumber>0</MinFileNumber>
                        <MaxFileNumber>200</MaxFileNumber>
                </FileListInfo>
                <FileListInfo>
                        <FileNameStub>quda_insert_2nd</FileNameStub>
                        <MinFileNumber>0</MinFileNumber>
                        <MaxFileNumber>200</MaxFileNumber>
                </FileListInfo>
          </InputFileListInfos>
        </InsertionInfo>
        <InverterInfo>
           <Name>GCR_MULTIGRID</Name>
           <Tolerance>1.0e-12</Tolerance>
           <MaxIterations>200</MaxIterations>
           <NKrylov>24</NKrylov>
           <MGPreconditioner>
              <NumLevels>2</NumLevels>
              <Level0>
                 <XYZTBlockExtents>4 4 4 4</XYZTBlockExtents>
                 <NullSpaceDim>S</NullSpaceDim>
                 <NullSpaceSolveSteps>300</NullSpaceSolveSteps>
                 <CoarseSolverTolerance>0.25</CoarseSolverTolerance>
                 <CoarseSolverMaxIterations>50</CoarseSolverMaxIterations>
                 <NumPreSmooth>0</NumPreSmooth>
                 <NumPostSmooth>4</NumPostSmooth>
              </Level0>
              <Level1>
                 <CoarseSolverTolerance>0.25</CoarseSolverTolerance>
                 <CoarseSolverMaxIterations>50</CoarseSolverMaxIterations>
                 <TRLMDeflation>
                    <NumVectors> 128 </NumVectors>
                    <Tolerance> 1e-6 </Tolerance>
                    <MaxIterations> 200 </MaxIterations>
                    <ChebyshevOrder> 16 </ChebyshevOrder>
                    <CutoffEigenvalue> 0.1 </CutoffEigenvalue>
                 </TRLMDeflation>
              </Level1>
              <LoadNullVectors>false</LoadNullVectors>
              <GenerateAllLevels>true</GenerateAllLevels>
              <PreOrthoNullVectors>true</PreOrthoNullVectors>
              <PostOrthoNullVectors>true</PostOrthoNullVectors>
              <SetupMinimizeMemory>false</SetupMinimizeMemory>
              <RunVerify>false</RunVerify>
           </MGPreconditioner>
        </InverterInfo>
        <Verbosity>none</Verbosity>
       <ExtraSolutionChecks/>
     </QuarkPerambulatorInfo>
     <VerboseOutput/>
        <InputFileListInfos>
                <FileListInfo>
                        <FileNameStub>quda_peramb</FileNameStub>
                        <MinFileNumber>0</MinFileNumber>
                        <MaxFileNumber>200</MaxFileNumber>
                </FileListInfo>
                <FileListInfo>
                        <FileNameStub>quda_peramb_2nd</FileNameStub>
                        <MinFileNumber>0</MinFileNumber>
                        <MaxFileNumber>200</MaxFileNumber>
                </FileListInfo>
        </InputFileListInfos>

 </Task>
</QudaLaph>
